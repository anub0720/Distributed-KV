  LINK_LIBRARIES = -lws2_32  -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32
  OBJECT_DIR = CMakeFiles\node.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = node.exe
  TARGET_IMPLIB = libnode.dll.a
  TARGET_PDB = node.exe.dbg
  TARGET_SUPPORT_DIR = CMakeFiles\node.dir


#############################################
# Utility command for test

build CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\ANUBHAB\Documents\Distributed-KV\build && C:\msys64\ucrt64\bin\ctest.exe "
  DESC = Running tests...
  pool = console
  restat = 1

build test: phony CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\ANUBHAB\Documents\Distributed-KV\build && C:\msys64\ucrt64\bin\cmake.exe -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\ANUBHAB\Documents\Distributed-KV\build && C:\msys64\ucrt64\bin\cmake.exe --regenerate-during-build -SD:\ANUBHAB\Documents\Distributed-KV -BD:\ANUBHAB\Documents\Distributed-KV\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

